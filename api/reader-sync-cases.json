    {
      "id": "detach_resume_reloads_manifest",
      "title": "detach -> paused/offline; RESUME -> manifest unicast -> READY -> reading",
      "setup": "reading", "resolver": "work",
      "steps": [
        {"op": "detach", "link": "L2"},
        {"op": "expect", "link": "L1", "frames": [
          {"v": 1, "type": "STATE", "sessionId": "@session", "revision": 7,
           "workEpoch": 1, "manifestVersion": 1, "phase": "paused",
           "spreadId": "c0:s0", "offset": 0, "leaderSide": "left",
           "dataPlane": "server-ws",
           "presence": {
             "@L1.member": {"role": "leader", "status": "active",
                            "name": "Alice", "ready": true},
             "@L2.member": {"role": "follower", "status": "offline",
                            "name": "Bob", "ready": false}}}]},
        {"op": "link", "as": "L3",
         "user": {"email": "bob@example.com", "name": "Bob", "picture": ""}},
        {"op": "expect", "link": "L3", "frames": [
          {"v": 1, "type": "HELLO", "link": "@L3.link"}]},
        {"op": "send", "link": "L3", "frame": {
          "v": 1, "requestId": "r3", "sessionId": "@session", "workEpoch": 0,
          "baseRevision": 0, "type": "RESUME",
          "payload": {"memberId": "@L2.member",
                      "resumeToken": "@L2.token"}}},
        {"op": "expect", "link": "L3", "frames": [
          {"v": 1, "type": "ACK", "requestId": "r3", "request": "RESUME",
           "sessionId": "@session",
           "data": {"sessionId": "@session", "memberId": "@L2.member",
                    "role": "follower", "resumeToken": "@L2.token"}},
          {"v": 1, "type": "STATE", "sessionId": "@session", "revision": 8,
           "workEpoch": 1, "manifestVersion": 1, "phase": "loading",
           "spreadId": "c0:s0", "offset": 0, "leaderSide": "left",
           "dataPlane": "server-ws",
           "presence": {
             "@L1.member": {"role": "leader", "status": "active",
                            "name": "Alice", "ready": true},
             "@L2.member": {"role": "follower", "status": "active",
                            "name": "Bob", "ready": false}}},
          {"v": 1, "kind": "manifest-chunk", "digest": "@digest",
           "index": 0, "count": 1, "data": "@manifest.canonical",
           "type": "MANIFEST", "sessionId": "@session",
           "workEpoch": 1, "manifestVersion": 1}]},
        {"op": "expect", "link": "L1", "frames": [
          {"v": 1, "type": "STATE", "sessionId": "@session", "revision": 8,
           "workEpoch": 1, "manifestVersion": 1, "phase": "loading",
           "spreadId": "c0:s0", "offset": 0, "leaderSide": "left",
           "dataPlane": "server-ws",
           "presence": {
             "@L1.member": {"role": "leader", "status": "active",
                            "name": "Alice", "ready": true},
             "@L2.member": {"role": "follower", "status": "active",
                            "name": "Bob", "ready": false}}}]},
        {"op": "send", "link": "L3", "frame": {
          "v": 1, "requestId": "r4", "sessionId": "@session", "workEpoch": 1,
          "baseRevision": 8, "type": "READY",
          "payload": {"manifestVersion": 1}}},
        {"op": "expect", "link": "L3", "frames": [
          {"v": 1, "type": "ACK", "requestId": "r4", "request": "READY",
           "sessionId": "@session", "data": {}},
          {"v": 1, "type": "APPLIED", "sessionId": "@session",
           "requestId": "r4", "revision": 9, "by": "follower"},
          {"v": 1, "type": "STATE", "sessionId": "@session", "revision": 9,
           "workEpoch": 1, "manifestVersion": 1, "phase": "reading",
           "spreadId": "c0:s0", "offset": 0, "leaderSide": "left",
           "dataPlane": "server-ws",
           "presence": {
             "@L1.member": {"role": "leader", "status": "active",
                            "name": "Alice", "ready": true},
             "@L2.member": {"role": "follower", "status": "active",
                            "name": "Bob", "ready": true}}}]},
        {"op": "expect", "link": "L1", "frames": [
          {"v": 1, "type": "APPLIED", "sessionId": "@session",
           "requestId": "r4", "revision": 9, "by": "follower"},
          {"v": 1, "type": "STATE", "sessionId": "@session", "revision": 9,
           "workEpoch": 1, "manifestVersion": 1, "phase": "reading",
           "spreadId": "c0:s0", "offset": 0, "leaderSide": "left",
           "dataPlane": "server-ws",
           "presence": {
             "@L1.member": {"role": "leader", "status": "active",
                            "name": "Alice", "ready": true},
             "@L2.member": {"role": "follower", "status": "active",
                            "name": "Bob", "ready": true}}}]}
      ]
    },
    {
      "id": "leave_ends_session_for_all",
      "title": "LEAVE -> END(reason=left) to every member, no ACK",
      "setup": "pairing",
      "steps": [
        {"op": "send", "link": "L2", "frame": {
          "v": 1, "requestId": "l1", "sessionId": "@session", "workEpoch": 0,
          "baseRevision": 2, "type": "LEAVE", "payload": {}}},
        {"op": "expect", "link": "L2", "frames": [
          {"v": 1, "type": "END", "sessionId": "@session",
           "reason": "left"}]},
        {"op": "expect", "link": "L1", "frames": [
          {"v": 1, "type": "END", "sessionId": "@session",
           "reason": "left"}]}
      ]
    },
    {
      "id": "error_paths",
      "title": "bad code / malformed / not_paired / no_pending REJECTs",
      "steps": [
        {"op": "link", "as": "X",
         "user": {"email": "carol@example.com", "name": "Carol",
                  "picture": ""}},
        {"op": "drain", "link": "X"},
        {"op": "send", "link": "X", "frame": {
          "v": 1, "requestId": "jx", "sessionId": null, "workEpoch": 0,
          "baseRevision": 0, "type": "JOIN", "payload": {"code": "999999"}}},
        {"op": "expect", "link": "X", "frames": [
          {"v": 1, "type": "REJECT", "requestId": "jx", "request": "JOIN",
           "reason": "bad_code", "sessionId": null}]},
        {"op": "send", "link": "X", "frame": {"v": 1, "requestId": "m1"}},
        {"op": "expect", "link": "X", "frames": [
          {"v": 1, "type": "REJECT", "requestId": "m1", "request": null,
           "reason": "malformed", "sessionId": null}]},
        {"op": "link", "as": "L1",
         "user": {"email": "alice@example.com", "name": "Alice",
                  "picture": ""}},
        {"op": "drain", "link": "L1"},
        {"op": "send", "link": "L1", "frame": {
          "v": 1, "requestId": "c1", "sessionId": null, "workEpoch": 0,
          "baseRevision": 0, "type": "CREATE", "payload": {}}},
        {"op": "drain", "link": "L1"},
        {"op": "send", "link": "L1", "frame": {
          "v": 1, "requestId": "o1", "sessionId": "@session", "workEpoch": 0,
          "baseRevision": 1, "type": "OPEN_WORK",
          "payload": {"folder": "work",
                      "page": {"folder": "work", "name": "p001.png"},
                      "offset": 0}}},
        {"op": "expect", "link": "L1", "frames": [
          {"v": 1, "type": "REJECT", "requestId": "o1",
           "request": "OPEN_WORK", "reason": "not_paired",
           "sessionId": null}]},
        {"op": "send", "link": "L1", "frame": {
          "v": 1, "requestId": "a9", "sessionId": "@session", "workEpoch": 0,
          "baseRevision": 1, "type": "APPROVE",
          "payload": {"memberId": "deadbeef"}}},
        {"op": "expect", "link": "L1", "frames": [
          {"v": 1, "type": "REJECT", "requestId": "a9", "request": "APPROVE",
           "reason": "no_pending", "sessionId": "@session"}]}
      ]
    }
  ]
}
