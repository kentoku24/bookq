          "baseRevision": 0, "type": "CREATE", "payload": {}}},
        {"op": "expect", "link": "L1", "frames": [
          {"v": 1, "type": "ACK", "requestId": "c1", "request": "CREATE",
           "sessionId": "@session",
           "data": {"sessionId": "@session", "code": "@code",
                    "memberId": "@L1.member", "role": "leader",
