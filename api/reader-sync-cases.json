    {
      "id": "dedup_replay_and_stale_rejects",
      "title": "resend replays ACK; stale revision/epoch -> REJECT + snapshot",
      "setup": "reading", "resolver": "work",
      "steps": [
        {"op": "send", "link": "L1", "frame": {
          "v": 1, "requestId": "t1", "sessionId": "@session", "workEpoch": 1,
          "baseRevision": 6, "type": "TURN",
          "payload": {"delta": 1, "crossChapter": true}}},
        {"op": "drain", "link": "L1"}, {"op": "drain", "link": "L2"},
        {"op": "send", "link": "L1", "frame": {
          "v": 1, "requestId": "t1", "sessionId": "@session", "workEpoch": 1,
          "baseRevision": 6, "type": "TURN",
          "payload": {"delta": 1, "crossChapter": true}}},
        {"op": "expect", "link": "L1", "frames": [
          {"v": 1, "type": "ACK", "requestId": "t1", "request": "TURN",
           "sessionId": "@session", "data": {}}]},
        {"op": "expect", "link": "L2", "frames": []},
        {"op": "send", "link": "L2", "frame": {
          "v": 1, "requestId": "t2", "sessionId": "@session", "workEpoch": 1,
          "baseRevision": 6, "type": "GOTO",
          "payload": {"page": {"folder": "work", "name": "p003.png"}}}},
        {"op": "expect", "link": "L2", "frames": [
          {"v": 1, "type": "REJECT", "requestId": "t2", "request": "GOTO",
