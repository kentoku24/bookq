                        "phase": "reading", "spreadId": "c0:s1",
                        "offset": 0, "leaderSide": "left",
                        "dataPlane": "server-ws"}}]},
        {"op": "expect", "link": "L1", "frames": []},
        {"op": "send", "link": "L1", "frame": {
          "v": 1, "requestId": "g1", "sessionId": "@session", "workEpoch": 0,
