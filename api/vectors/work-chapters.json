        {"name": "w", "type": "folder", "children": [
          {"name": "01", "type": "folder", "children": [
            {"name": "p1.png", "type": "image"},
            {"name": "p2.png", "type": "image"}
          ]},
          {"name": "02", "type": "folder", "children": [
            {"name": "p1.png", "type": "image"}
          ]},
          {"name": "sub", "type": "folder", "children": [
            {"name": "x", "type": "folder", "children": [
              {"name": "a.png", "type": "image"}
            ]}
          ]}
        ]}
      ],
      "folder": "w/01",
      "expectCross": false,
      "expectChapterFolders": ["w/01"],
      "expectChapters": [
        {"name": "01", "folder": "w/01", "pages": ["p1.png", "p2.png"]}
      ]
    },
