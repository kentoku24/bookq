# bookq — Environment variables
#
# Google OAuth 2.0 credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Session signing key — generate with: openssl rand -hex 32
# Required outside BOOKQ_TEST_MODE=true (startup fails without it)
SECRET_KEY=change-me-to-a-random-64-char-string

# External base URL (used for OAuth redirect URI)
BASE_URL=https://bookq.<your-tailnet>.ts.net

# Dev 環境の tailnet ドメイン（例: <your-tailnet>.ts.net）。未設定なら
# BASE_URL から導出する（dev.sh が https://dev-<名前>.<ドメイン> を組み立てる）。
# DEV_TS_DOMAIN=<your-tailnet>.ts.net

# Comma-separated list of allowed Google account emails
ALLOWED_EMAILS=your.email@gmail.com

# TS_AUTHKEY: Tailscale auth key (reusable).
# Generate at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxxxx

# TS_API_KEY: Tailscale API token (optional). Used by `./dev.sh down --full`
# to delete the tailnet node registration. Generate at:
# https://login.tailscale.com/admin/settings/keys (owner/admin role required).
# Format: tskey-api-xxxxxxxx
# TS_API_KEY=tskey-api-xxxxxxxx

# TS_TAILNET: Tailscale tailnet for the API (optional). Defaults to the API's
# default tailnet (`-`).
# TS_TAILNET=<your-tailnet>.ts.net

# キー期限の記録 — scripts/ensure-ts-authkey.sh が残14日/期限切れで警告する。
# キー再発行時は日付も更新すること。
# TS_AUTHKEY_EXPIRES=YYYY-MM-DD
# TS_API_KEY_EXPIRES=YYYY-MM-DD
# TS_AUTHKEY_ID=kXXXXXXXXXXXXCNTRL    # ensure-ts-authkey.sh が自動管理

# OAuth client (optional, recommended).設定すると ensure-ts-authkey.sh が
# 期限切れ前の TS_AUTHKEY を自動で mint し .env を更新する。Trust credentials
# (https://login.tailscale.com/admin/settings/trust-credentials) で発行、
# scope は auth_keys（down --full のノード削除にも使うなら devices も）。
# secret に期限はない。mint されるキーは tailnet 所有でタグ必須 — 既定
# tag:bookq-dev は tailnet ACL の tagOwners に登録が必要（TS_AUTHKEY_TAGS で変更可）。
# TS_OAUTH_CLIENT_ID=xxxxxxxx
# TS_OAUTH_CLIENT_SECRET=tskey-client-xxxxxxxx
# TS_AUTHKEY_TAGS=tag:bookq-dev

# Host directory holding the image tree. Optional — defaults to ./downloads
# (set DOWNLOADS_HOST_DIR for production data). Both docker-compose.yml and docker-compose.dev.yml read it
# (the dev one mounts it read-only).
# DOWNLOADS_HOST_DIR=/Users/you/path/to/downloads

# ── viewer-rs strangler (#211, optional) ─────────────────────────────
# tailscale serve の宛先。未設定 = http://viewer:8080（従来どおり）。
# http://viewer-rs:8080 にすると全 traffic が viewer-rs を経由する。
# 空文字 = serve 設定を外部管理（entrypoint が serve に触らない）。
# 有効化には `docker compose --profile rs up -d viewer-rs` も必要
# （手順は docs/deployment.md「viewer-rs strangler 導入」）。
# TS_SERVE_TARGET=http://viewer-rs:8080

# viewer-rs が native 処理する endpoint のカンマ区切りリスト。
# 空/未設定 = 全リクエストを viewer に proxy（traffic-shape 検証のみ）。
# BOOKQ_RS_NATIVE=health,version

# ── Tailscale Funnel による一般公開 (#353, optional) ───────────────────
# 1 にすると tailscale serve を funnel に切替え、https://bookq.<tailnet>.ts.net
# が tailnet 外の public internet からも到達できるようになる。ドメイン購入・
# DNS 移管・Cloudflare アカウントは不要。BASE_URL / OAuth redirect URI は
# 変更不要。前提として tailnet policy file (admin console → ACL) の
# nodeAttrs に funnel 許可が必要:
#   "nodeAttrs": [{"target": ["*"], "attr": ["funnel"]}]
# 手順は docs/deployment.md「一般公開（Tailscale Funnel）」を参照。
# TS_FUNNEL=1
