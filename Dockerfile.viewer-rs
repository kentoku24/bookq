# viewer-rs — Rust backend (issue #163, parallel-backend track).
# Two-stage: cargo build → slim runtime. The context is the repo root;
# only rust/ is needed.

# Pinned to bookworm: the runtime stage is bookworm-slim, and unrar's
# bundled C++ compiled under a newer builder (trixie g++14) would emit
# GLIBCXX/CXXABI symbol versions bookworm's libstdc++6 can't satisfy.
FROM rust:1-slim-bookworm AS rsbuilder
# g++ compiles the bundled RARLAB unrar C++ (bookq-core `unrar` dep).
RUN apt-get update && apt-get install -y --no-install-recommends zlib1g-dev g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /src

# Dependency layer (#380): manifests + stub sources so this `cargo build`
# compiles only third-party crates (~3min). The stub RUN sits before the
# real-source COPY, so source-only edits keep this layer — and its
# type=gha cache entry — intact; only workspace crates rebuild below.
# Keep the stub list in sync with `members` in rust/Cargo.toml.
COPY rust/Cargo.toml rust/Cargo.lock ./rust/
COPY rust/bookq-core/Cargo.toml ./rust/bookq-core/Cargo.toml
COPY rust/viewer-rs/Cargo.toml ./rust/viewer-rs/Cargo.toml
RUN mkdir -p rust/bookq-core/src rust/viewer-rs/src \
    && : > rust/bookq-core/src/lib.rs \
    && printf 'fn main() {}\n' > rust/viewer-rs/src/main.rs \
    && cargo build --release --manifest-path rust/Cargo.toml -p viewer-rs

COPY rust/ ./rust/
# api/user-state-schema.sql is embedded via include_str! (#200)
COPY api/ ./api/
# BuildKit COPY preserves context mtimes, so freshly-checked-out sources
# look OLDER than the stub build's fingerprint and cargo would ship the
# stub binary (observed: final build "Finished in 0.08s"). touch forces
# every copied file newer than the fingerprint so exactly the workspace
# crates rebuild; third-party dep artifacts stay cached. api/ is touched
# too — include_str! tracks that file's mtime the same way. rust/target
# is pruned: it holds the stub build's dep artifacts + dep-info files,
# and touching those could flip cargo's freshness check either way.
RUN find rust api -type f -not -path '*/target/*' -exec touch {} + \
    && cargo build --release --manifest-path rust/Cargo.toml -p viewer-rs \
    && cp rust/target/release/viewer-rs /viewer-rs-bin

FROM debian:bookworm-slim
# libstdc++6 carries the unrar C++ runtime the binary links against.
# libpdfium carries the native PDF pipeline (#402): pdfium-render binds it
# at runtime (dlopen — no build-time link), the same PDFium engine as
# pypdfium2. Prebuilt: bblanchon/pdfium-binaries, pinned to the
# pdfium-render `pdfium_latest` release (8125). Size: tarball ~3.8MB,
# installed libpdfium.so ~7.7MB.
ARG PDFIUM_VERSION=8125
# TARGETARCH: buildx のビルドプラットフォーム（prod ホストは ARM64 — x64
# 固定だと bind 不能で render が proxy 落ちする latent bug だった #456）。
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends zlib1g libstdc++6 ca-certificates curl \
    && case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
         amd64) pdfium_arch=x64 ;; \
         arm64) pdfium_arch=arm64 ;; \
         *) echo "unsupported arch for pdfium: ${TARGETARCH:-$(dpkg --print-architecture)}" >&2; exit 1 ;; \
       esac \
    && curl -sSL -o /tmp/pdfium.tgz "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/${PDFIUM_VERSION}/pdfium-linux-${pdfium_arch}.tgz" \
    && mkdir -p /tmp/pdfium && tar xzf /tmp/pdfium.tgz -C /tmp/pdfium \
    && cp /tmp/pdfium/lib/libpdfium.so /usr/local/lib/ && ldconfig \
    && rm -rf /tmp/pdfium.tgz /tmp/pdfium \
    && apt-get purge -y curl && apt-get autoremove -y --purge \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rsbuilder /viewer-rs-bin /usr/local/bin/viewer-rs

# #401 native shell/static: only the three payload trees the Rust server
# reads — Python sources intentionally stay out of the Rust image.
COPY app/static /app/static
COPY app/templates /app/templates
COPY app/perf /app/perf

# No BOOKQ_UPSTREAM default — #408 makes "unset" mean upstream-absent
# (501/401 fail-fast). Dev/strangler stacks that still want the Python
# fall-through set it explicitly in compose.
ENV BOOKQ_BIND=0.0.0.0:8080
# #401 shell/static payload root (the /app tree copied above).
ENV BOOKQ_APP_DIR=/app

# Same build-arg contract as Dockerfile — /api/v1/version reports these.
ARG GIT_SHA=""
ARG BUILD_DATE=""
ENV BOOKQ_GIT_SHA=$GIT_SHA
ENV BOOKQ_BUILD_DATE=$BUILD_DATE

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/viewer-rs"]
